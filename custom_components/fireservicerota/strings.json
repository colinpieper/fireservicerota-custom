{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    },
    "create_entry": {
      "default": "[%key:common::config_flow::create_entry::authenticated%]"
    },
    "error": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        },
        "description": "Authentication tokens became invalid, log in to recreate them."
      },
      "user": {
        "data": {
          "password": "[%key:common::config_flow::data::password%]",
          "url": "Website",
          "username": "[%key:common::config_flow::data::username%]"
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "duty": {
        "name": "Duty"
      },
      "incident_active": {
        "name": "Incident active"
      },
      "incident_assigned": {
        "name": "Incident assigned"
      }
    },
    "event": {
      "incident": {
        "name": "Incident",
        "state_attributes": {
          "event_type": {
            "state": {
              "new": "New incident",
              "update": "Incident update",
              "response_closed": "Response closed",
              "ended": "Incident ended"
            }
          }
        }
      }
    },
    "sensor": {
      "incidents": {
        "name": "Incidents"
      },
      "deployment_percentage": {
        "name": "Deployment percentage"
      }
    },
    "switch": {
      "incident_response": {
        "name": "Incident response"
      }
    }
  },
  "exceptions": {
    "token_refresh_failed": {
      "message": "Failed to refresh the FireServiceRota authentication tokens"
    },
    "no_active_incident": {
      "message": "There is no active incident to respond to"
    },
    "set_availability_failed": {
      "message": "Failed to set the availability"
    },
    "end_before_start": {
      "message": "The end time must be after the start time"
    },
    "config_entry_not_found": {
      "message": "No loaded FireServiceRota account found"
    },
    "config_entry_required": {
      "message": "More than one FireServiceRota account is configured, select one"
    }
  },
  "selector": {
    "availability": {
      "options": {
        "available": "Available",
        "unavailable": "Unavailable",
        "clear": "Clear"
      }
    }
  },
  "services": {
    "set_availability": {
      "name": "Set availability",
      "description": "Sets your availability for a period, like a schedule exception in the app.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "The FireServiceRota account. Only needed when more than one is configured."
        },
        "start_time": {
          "name": "Start time",
          "description": "Start of the period. Defaults to now."
        },
        "end_time": {
          "name": "End time",
          "description": "End of the period."
        },
        "availability": {
          "name": "Availability",
          "description": "Available, unavailable, or clear the period so your regular schedule applies again."
        },
        "comments": {
          "name": "Comments",
          "description": "Comments shown with the period."
        }
      }
    }
  }
}
